            // UI text labels syncing
            document.getElementById('label-userBase').innerText = Number(userBase).toLocaleString();
            document.getElementById('label-adoptionRate').innerText = adoptionRate.toFixed(1) + '%';
            document.getElementById('label-monthlySpend').innerText = '$' + monthlySpend;
            document.getElementById('label-revShare').innerText = revShare + '%';
            
            // Model calculations
            const adoptingAccounts = Math.round(userBase * (adoptionRate / 100));
            const totalMonthlySpend = adoptingAccounts * monthlySpend;
            const partnerMonthlyARR = totalMonthlySpend * (revShare / 100);
            const partnerAnnualARR = partnerMonthlyARR * 12;
            const mmAnnualARR = (totalMonthlySpend - partnerMonthlyARR) * 12;
            
            // Format to dynamic metric labels
            document.getElementById('output-adoptingAccounts').innerText = Number(adoptingAccounts).toLocaleString();
            document.getElementById('output-partnerARR').innerText = formatCurrency(partnerAnnualARR);
            document.getElementById('output-retainedARR').innerText = formatCurrency(mmAnnualARR);
            
            // Adjust visualization splits
            const partnerRatio = revShare;
            const mmRatio = 100 - revShare;
            document.getElementById('bar-partner').style.width = partnerRatio + '%';
            document.getElementById('bar-mm').style.width = mmRatio + '%';
            
            // Sync output state
            currentMetrics = {
                userBase,
                adoptionRate,
                monthlySpend,
                revShare,
                partnerARR: partnerAnnualARR,
                retainedARR: mmAnnualARR,
                adoptingAccounts
            };
        }

        function formatCurrency(value) {
            if (value >= 1000000) {
                return '$' + (value / 1000000).toFixed(1) + 'M';
            } else if (value >= 1000) {
                return '$' + (value / 1000).toFixed(0) + 'K';
            }
            return '$' + value;
        }

