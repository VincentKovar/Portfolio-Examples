        // Interfacing Gemini LLM models directly
        async function generateProposal() {
            const partnerName = document.getElementById('copilot-partnerName').value;
            const toneAngle = document.getElementById('copilot-tone').value;
            const outputArea = document.getElementById('copilot-output');
            const loading = document.getElementById('loading-spinner');
            const keyInput = document.getElementById('api-key').value;
            
            outputArea.classList.add('hidden');
            loading.classList.remove('hidden');
            
            // Fallback key detection mechanism
            const apiKey = keyInput || "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
            
            // Pre-calculate variables mapping directly from simulator inputs
            const adoptingAccs = Number(currentMetrics.adoptingAccounts).toLocaleString();
            const partnerARRFormatted = formatCurrency(currentMetrics.partnerARR);
            const userBaseFormatted = Number(currentMetrics.userBase).toLocaleString();
            const adoptionRateFormatted = currentMetrics.adoptionRate.toFixed(1) + '%';
            
            const systemPrompt = `You are a world-class Head of Growth & Marketing at Misfits & Machines, pitching dynamic integration partnerships. Your target audience is a highly commercial, metric-focused VP of Partnerships. Frame the value proposition with bold conviction, using realistic financial assumptions. Emphasize that Misfits & Machines builds transformative technology that helps legacy platforms unlock massive advertising volume. Always write in a structured, concise, and direct style. Ensure you format output professionally as a business pitch proposal.`;
            
            const userQuery = `Write a compelling enterprise partnership outreach proposal to the VP of Partnerships at ${partnerName}.
            
            We are proposing to embed a dynamic programmatic audio and video ad creation feature directly inside their merchant app store ecosystem. 
            
            Use the following exact metrics sourced directly from our live monetization database model:
            - Target Partner Merchant Base: ${userBaseFormatted} active users
            - Projected Integration Adoption Rate: ${adoptionRateFormatted}
            - Estimated Net New Adopting Accounts: ${adoptingAccs}
            - Partner Split Incremental ARR Contribution: ${partnerARRFormatted} net ARR inside their system over the first 12 months.
            
            Compose the final proposal with a ${toneAngle} approach. Keep the length punchy, action-focused, and target an active calendar invite meeting booking next week.`;
            
            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                }
            };
            
            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                const result = await response.json();
                const text = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                
                if (text) {
                    outputArea.innerText = text;
                } else {
                    // Fallback simulated model outputs if API returns unexpected formats or is throttled
                    outputArea.innerText = generateFallbackProposal(partnerName, adoptingAccs, partnerARRFormatted, toneAngle);
                }
            } catch (err) {
                console.error("Gemini API call timed out, running dynamic client generator fallback...", err);
                outputArea.innerText = generateFallbackProposal(partnerName, adoptingAccs, partnerARRFormatted, toneAngle);
            } finally {
                loading.classList.add('hidden');
                outputArea.classList.remove('hidden');
            }
        }

